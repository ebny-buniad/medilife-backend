<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <title>OTP Verification</title>
</head>

<body style="margin:0;padding:0;font-family:Arial, Helvetica, sans-serif;background:#f4f6f8;">
    <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 0;">
        <tr>
            <td align="center">
                <table width="500" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;padding:30px;">
                    
                    <tr>
                        <td style="text-align:center;">
                            <h2 style="margin:0;color:#333;">OTP Verification</h2>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-top:20px;color:#555;font-size:16px;">
                            Hello <strong><%= name %></strong>,
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-top:15px;color:#555;font-size:15px;">
                            Use the following One-Time Password (OTP) to complete your verification.
                        </td>
                    </tr>

                    <tr>
                        <td align="center" style="padding:30px 0;">
                            <div style="font-size:32px;font-weight:bold;letter-spacing:6px;color:#2d89ef;">
                                <%= otp %>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="color:#777;font-size:14px;">
                            This OTP is valid for only 2 minutes. Please do not share it with anyone.
                        </td>
                    </tr>

                    <tr>
                        <td style="padding-top:25px;color:#555;font-size:14px;">
                            Thanks,<br/>
                            <strong>Medilife Team</strong>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
